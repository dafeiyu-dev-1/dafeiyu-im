@echo off
rem 复制为 server\.env.cmd 后填写。这个文件不要提交到仓库。
set IM_TOKEN=CHANGE_ME
rem 服务端口
set IM_PORT=8787
rem 可选：表情包种子目录、默认工作区
rem set STICKER_SEED=D:\\path\\to\\stickers
rem set DEFAULT_WORKSPACE=D:\\path\\to\\workspace
rem 可选：音色合成守护进程（没有就留空，应用会退化成纯文字）
rem set TTS_DAEMON=http://127.0.0.1:8788
rem 可选：华为推送（不填则不启用推送）
rem set PUSH_APP_ID=
rem set PUSH_CLIENT_ID=
rem set PUSH_CLIENT_SECRET=
